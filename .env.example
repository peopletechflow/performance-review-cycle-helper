# fixture (default, example data, embedded Postgres) or live
MODE=fixture
FIXTURE_USER=emp_ava

# --- live mode: Workday Agent Gateway (documented Workday path; values from ASOR agent configuration) ---
# NODE_ENV=production
# DATABASE_URL=postgres://USER@127.0.0.1:5432/review_cycle_helper
# WORKDAY_AGENT_GATEWAY=us.agent.workday.com
# WORKDAY_TENANT_ALIAS=your_tenant_alias
# ASU_CLIENT_ID=from_asor_configure_agent
# ASU_CLIENT_SECRET_FILE=/path/to/asu-client-secret   (chmod 600)
# ASU_REDIRECT_URI=https://your-agent.example.com/oauth/callback   (the redirect URI registered on the agent)
# ASU_SESSION_FILE=/path/to/asu-session.json   (written by `pnpm asu:login`, chmod 600)
# AGENT_TOOL_POLICY_PATH=/path/to/agent-tool-policy.json   (reviewed; see examples/agent-tool-policy.example.json)
# ROLE_MAP_PATH=/path/to/role-map.json

# --- live mode: direct mapping (other MCP servers you run; not production, not Workday Agent Gateway) ---
# DATABASE_URL=postgres://USER@127.0.0.1:5432/review_cycle_helper
# WORKDAY_MCP_URL=https://REPLACE/mcp
# WORKDAY_MCP_TOKEN_FILE=/path/to/your-own-token   (chmod 600, never shared)
# WORKDAY_MCP_MAPPING_PATH=/path/to/mapping.json
# ROLE_MAP_PATH=/path/to/role-map.json
# DISABLED_TOOLS=
# DISABLED_CAPABILITIES=

# --- evidence sources (each still needs the user's explicit opt-in) ---
# Your own read-only GitHub token (fine-grained, metadata + pull requests read), chmod 600
# GITHUB_TOKEN_FILE=/path/to/github-token
# Optional repo scope, comma separated owner/repo
# GITHUB_REPO_ALLOWLIST=
# WORKDAY_TENANT=your-tenant   # used when upstream identity has no tenant id
