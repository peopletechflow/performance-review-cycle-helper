# fixture (default, example data, embedded Postgres) or live
MODE=fixture
FIXTURE_USER=emp_ava

# --- live mode (Workday MCP upstream) ---
# DATABASE_URL=postgres://USER@127.0.0.1:5432/review_cycle_helper
# WORKDAY_MCP_URL=https://REPLACE/mcp
# WORKDAY_MCP_TOKEN_FILE=/path/to/your-own-token   (chmod 600, never shared)
# WORKDAY_MCP_MAPPING_PATH=/path/to/mapping.json
# ROLE_MAP_PATH=/path/to/role-map.json
# DISABLED_TOOLS=
# DISABLED_CAPABILITIES=

# --- evidence sources (each still needs the user's explicit opt-in) ---
# Your own read-only GitHub token (fine-grained, metadata + pull requests read), chmod 600
# GITHUB_TOKEN_FILE=/path/to/github-token
# Optional repo scope, comma separated owner/repo
# GITHUB_REPO_ALLOWLIST=
